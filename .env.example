# Copy this file to .env and adjust values.
# Shared by the standalone CLI script (process_events.py), the app/ service
# (api + worker containers), the frontend build (docker-compose reads this file
# directly for ${VAR} substitution), and Vite itself if you run `npm run dev`
# outside Docker (Vite auto-loads .env from the project root).

# --- Frontend (traffic-incidents-dashboard) ---------------------------------
# Baked into the JS bundle at build time — rebuild the web image after changing this.
VITE_API_BASE_URL=http://localhost:9911
# CARTO's free dark basemap tiles, no API key needed — matches the dashboard's
# dark theme and the attribution text already hardcoded in TunisiaMap.tsx.
VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png

# --- Database (used by app/, not by process_events.py) ---------------------
# Set for running api/worker natively (docker-compose.yml just runs Postgres,
# published on localhost:5432). Using docker-compose.full.yml instead (api +
# worker also containerized)? That file overrides this to point at `db:5432`.
DATABASE_URL=postgresql+psycopg2://morour:morour@localhost:5432/morour

# --- Source API -------------------------------------------------------------
API_BASE_URL=http://172.19.0.37:8003
EVENTS_PATH=/events
# Query param names sent to the API (adjust if the real API expects different names)
START_PARAM=start
CATEGORY_PARAM=category

# Selected start date and category for the /events request
START_DATE=2026-08-18T00:00:00
CATEGORY=أحداث مرورية

REQUEST_TIMEOUT=30

# --- Ollama -------------------------------------------------------------
# Set for running api/worker natively, where "localhost" correctly means this
# machine. docker-compose.full.yml overrides this to host.docker.internal for
# the containerized api/worker, since inside a container "localhost" would
# mean the container itself, not your GPU host.
OLLAMA_HOST=http://localhost:11434
OLLAMA_TIMEOUT=60

# Model used to pick the sub-category from subcategory.txt
CLASSIFICATION_MODEL=llama3.2:1b
# Model used to extract structured fields from event_summary (schemaextractevent.txt)
EXTRACTION_MODEL=llama3.2:1b

# --- Dev / offline mode ---------------------------------------------------
# Set to true to skip the real API entirely and read from SAMPLE_DATA_FILE
# (also used automatically as a fallback if the real API request fails)
USE_SAMPLE_DATA=true
SAMPLE_DATA_FILE=data.json.txt
SUBCATEGORY_FILE=subcategory.txt
SCHEMA_FILE=schemaextractevent.txt

# --- Worker (app/worker.py) ------------------------------------------------
# How often to poll the source API for new events, in seconds.
POLL_INTERVAL_SECONDS=60
# Re-query this many minutes before the latest event time already seen, as a
# safety margin against events landing slightly out of order.
POLL_OVERLAP_MINUTES=5
