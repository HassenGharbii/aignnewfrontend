# Copy this file to .env and adjust values.
# Shared by the standalone CLI script (process_events.py), the app/ service
# (api + worker containers), the frontend build (docker-compose reads this file
# directly for ${VAR} substitution), and Vite itself if you run `npm run dev`
# outside Docker (Vite auto-loads .env from the project root).

# --- Frontend (traffic-incidents-dashboard) ---------------------------------
# Baked into the JS bundle at build time — rebuild the web image after changing this.
VITE_API_BASE_URL=http://localhost:9911
# CARTO's free dark basemap tiles, no API key needed — matches the dashboard's
# dark theme and the attribution text already hardcoded in TunisiaMap.tsx.
VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png

# --- Database (used by app/, not by process_events.py) ---------------------
# Set for running api/worker natively (docker-compose.yml just runs Postgres,
# published on localhost:5432). Using docker-compose.full.yml instead (api +
# worker also containerized)? That file overrides this to point at `db:5432`.
DATABASE_URL=postgresql+psycopg2://morour:morour@localhost:5432/morour

# --- Source API -------------------------------------------------------------
# Running natively? Point this straight at the source API.
# Running the full Docker stack? docker-compose.yml overrides this to
# http://proxy:8004 and the `proxy` service forwards to PROXY_TARGET_* below.
API_BASE_URL=http://172.19.0.37:8003
EVENTS_PATH=/events

# --- Source API proxy (proxy.py / the `proxy` container) --------------------
# Where the forwarder sends traffic. Must be the real source API address.
PROXY_TARGET_HOST=172.19.0.37
PROXY_TARGET_PORT=8003
# Query param names sent to the API (adjust if the real API expects different names)
START_PARAM=start
CATEGORY_PARAM=category

# Selected start date and category for the /events request
START_DATE=2026-08-18T00:00:00
CATEGORY=أحداث مرورية

REQUEST_TIMEOUT=30
# Confirmed from the source API's own openapi.json: /events paginates via
# page (1-indexed) + page_size (default 50 server-side) — not offset/skip.
EVENTS_PAGE_SIZE=50

# --- vLLM (inference server) ----------------------------------------------
# Running natively? Point this at a vLLM you started yourself (default port
# 8000). Running the Docker stack? docker-compose.yml overrides it to
# http://vllm:8000 and runs the server for you.
VLLM_HOST=http://localhost:8000

# The model vLLM serves. docker-compose.yml reads VLLM_MODEL directly for the
# server's --model flag AND injects it as both model vars below, so those three
# can never drift apart -- vLLM serves exactly one model per process, and a
# mismatch fails every call with a 404.
#
# Sized for a ~15GB VRAM budget (--gpu-memory-utilization 0.46 on a 32GB card):
#   Qwen/Qwen3-14B-AWQ   int4, ~8.5GB weights, ~6GB left for KV cache  <- default
#   Qwen/Qwen3-8B-FP8    fp8,  ~8.2GB weights, smaller model, less quantized
#   Qwen/Qwen3-14B-FP8   fp8, ~14.8GB weights -- needs ~20GB, will OOM at 15GB
VLLM_MODEL=Qwen/Qwen3-14B-AWQ
VLLM_GPU_FRACTION=0.46
VLLM_MAX_MODEL_LEN=8192

# A 14B is far slower per call than the 1B this replaced, and the first guided
# request additionally pays for grammar compilation.
VLLM_TIMEOUT=300
# Max tokens generated per call (stops runaway generations early)
VLLM_MAX_TOKENS=1536
# Qwen3 is a hybrid reasoning model. Its <think> blocks are not valid under the
# JSON schemas used for guided decoding, so leaving this on yields malformed
# output. Debugging only.
VLLM_ENABLE_THINKING=false

# Only needed for gated HuggingFace repos. The default model is ungated.
HUGGING_FACE_HUB_TOKEN=

# A failed record is retried until it has failed this many times
MAX_CLASSIFY_ATTEMPTS=3

# Both must match VLLM_MODEL. The Docker stack sets them for you.
CLASSIFICATION_MODEL=Qwen/Qwen3-14B-AWQ
EXTRACTION_MODEL=Qwen/Qwen3-14B-AWQ

# --- Warm-up (app/warmup.py) ----------------------------------------------
# How long to wait for vLLM to load weights before giving up. The first run
# also downloads them (~9GB), so keep this generous.
WARMUP_READY_TIMEOUT=1800
WARMUP_CALL_TIMEOUT=600

# --- Dev / offline mode ---------------------------------------------------
# Set to true to skip the real API entirely and read from SAMPLE_DATA_FILE
# (also used automatically as a fallback if the real API request fails)
USE_SAMPLE_DATA=true
SAMPLE_DATA_FILE=data.json.txt
SUBCATEGORY_FILE=subcategory.txt
SCHEMA_FILE=schemaextractevent.txt

# --- Worker (app/worker.py) ------------------------------------------------
# Re-classify every record already in the database when the worker starts,
# before the normal fetch+classify loop. Set to false to skip it on restarts.
BACKFILL_ON_START=true
# How often to poll the source API for new events, in seconds.
POLL_INTERVAL_SECONDS=60
# Re-query this many minutes before the latest event time already seen, as a
# safety margin against events landing slightly out of order.
POLL_OVERLAP_MINUTES=5
